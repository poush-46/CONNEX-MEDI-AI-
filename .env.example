# ---------------------------------------------------------------------------
# Connex — environment variables
#
# Copy to `.env.local` for local development. NEVER commit real values.
# Every variable below is optional in the current build: with no .env file at
# all the app runs fully on the deterministic mock engine.
# ---------------------------------------------------------------------------

# --- AI provider -----------------------------------------------------------
# Which engine answers chat requests.
#   mock  = deterministic local intent router (default, no network, no key)
#   openai / anthropic = reserved for a future stage, not yet implemented
AI_PROVIDER=mock

# Credentials for a real provider. Leave blank while AI_PROVIDER=mock.
# Server-side only — must never be prefixed with NEXT_PUBLIC_.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_MAX_TOKENS=1024

# --- Demo behaviour --------------------------------------------------------
# Artificial latency range (ms) so loading states are exercised realistically.
DEMO_LATENCY_MIN_MS=180
DEMO_LATENCY_MAX_MS=520

# Verbose server-side request logging.
DEBUG_LOGGING=false

# --- Database (future stage) ----------------------------------------------
# Unused today; the app stores demo state in memory.
DATABASE_URL=
