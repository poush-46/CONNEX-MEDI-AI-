name: CI

on:
  push:
    branches: ['**']
  pull_request:

jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
      - run: npm ci
      - run: npm run typecheck
      - run: npm run lint
      - run: npm test
      - run: npm run build

# ---------------------------------------------------------------------------
# To enable: move this file to .github/workflows/ci.yml and commit.
# It is kept here because the connected GitHub App lacks `workflows`
# permission, which blocks pushing files under .github/workflows/.
# ---------------------------------------------------------------------------
